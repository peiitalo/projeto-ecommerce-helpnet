<style type="text/css">
  /* Email-specific styles */
  body, table, td, p, a, li, blockquote {
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
  }
  table, td {
    mso-table-lspace: 0pt;
    mso-table-rspace: 0pt;
  }
  img {
    -ms-interpolation-mode: bicubic;
    border: 0;
    height: auto;
    line-height: 100%;
    outline: none;
    text-decoration: none;
  }

  /* Base styles */
  body {
    margin: 0 !important;
    padding: 0 !important;
    background: linear-gradient(135deg, #F8FAFC 0%, #E2E8F0 100%) !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', 'Roboto', 'Helvetica Neue', Arial, sans-serif !important;
    font-size: 16px !important;
    line-height: 1.6 !important;
    color: #1E293B !important;
  }

  /* Email wrapper */
  .email-wrapper {
    width: 100% !important;
    background: linear-gradient(135deg, #F8FAFC 0%, #E2E8F0 100%) !important;
    padding: 32px 0 !important;
  }

  /* Main container */
  .email-container {
    max-width: 600px !important;
    margin: 0 auto !important;
    background-color: #FFFFFF !important;
    border-radius: 12px !important;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
    overflow: hidden !important;
    border: 1px solid rgba(226, 232, 240, 0.8) !important;
  }

  /* Header */
  .header {
    background: linear-gradient(135deg, #4F46E5 0%, #3B82F6 100%) !important;
    padding: 40px 32px !important;
    text-align: center !important;
  }

  .logo {
    font-size: 36px !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
    margin: 0 !important;
    letter-spacing: -0.025em !important;
  }

  .title {
    font-size: 28px !important;
    font-weight: 600 !important;
    color: #FFFFFF !important;
    margin: 16px 0 0 0 !important;
    letter-spacing: -0.025em !important;
  }

  /* Content */
  .content {
    padding: 48px 32px !important;
  }

  .content h1 {
    font-size: 28px !important;
    font-weight: 700 !important;
    color: #1E293B !important;
    margin: 0 0 24px 0 !important;
    letter-spacing: -0.025em !important;
    line-height: 1.2 !important;
  }

  .content h2 {
    font-size: 20px !important;
    font-weight: 600 !important;
    color: #334155 !important;
    margin: 32px 0 16px 0 !important;
    letter-spacing: -0.025em !important;
  }

  .content p {
    font-size: 16px !important;
    line-height: 1.7 !important;
    color: #64748B !important;
    margin: 0 0 20px 0 !important;
  }

  .content strong {
    color: #1E293B !important;
    font-weight: 600 !important;
  }

  /* Button */
  .button {
    display: inline-block !important;
    background: linear-gradient(135deg, #4F46E5 0%, #3B82F6 100%) !important;
    color: #FFFFFF !important;
    padding: 16px 32px !important;
    text-decoration: none !important;
    border-radius: 8px !important;
    font-weight: 600 !important;
    font-size: 16px !important;
    margin: 24px 0 !important;
    box-shadow: 0 4px 14px 0 rgba(79, 70, 229, 0.25) !important;
    min-height: 44px !important;
    line-height: 1.2 !important;
  }

  /* Success message */
  .success-message {
    background: linear-gradient(135deg, #DCFCE7 0%, #F0FDF4 100%) !important;
    border: 1px solid #BBF7D0 !important;
    border-radius: 12px !important;
    padding: 24px !important;
    margin: 24px 0 !important;
    text-align: center !important;
  }

  .success-message h3 {
    margin: 0 0 16px 0 !important;
    font-size: 20px !important;
    font-weight: 600 !important;
    color: #166534 !important;
  }

  /* Order details */
  .order-details {
    background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%) !important;
    border: 1px solid #E2E8F0 !important;
    border-radius: 12px !important;
    padding: 24px !important;
    margin: 24px 0 !important;
  }

  .order-details h3 {
    margin: 0 0 16px 0 !important;
    font-size: 18px !important;
    font-weight: 600 !important;
    color: #1E293B !important;
  }

  .order-details p {
    margin: 10px 0 !important;
    font-size: 15px !important;
    color: #64748B !important;
    line-height: 1.6 !important;
  }

  .order-details strong {
    color: #1E293B !important;
    font-weight: 600 !important;
  }

  /* Footer */
  .footer {
    background: linear-gradient(135deg, #1E293B 0%, #334155 100%) !important;
    padding: 48px 32px !important;
    text-align: center !important;
    color: #FFFFFF !important;
  }

  .footer h4 {
    font-size: 20px !important;
    font-weight: 700 !important;
    margin: 0 0 20px 0 !important;
    color: #FFFFFF !important;
  }

  .footer p {
    font-size: 15px !important;
    line-height: 1.6 !important;
    margin: 0 0 12px 0 !important;
    color: #CBD5E1 !important;
  }

  /* Mobile responsive */
  @media only screen and (max-width: 600px) {
    .email-wrapper {
      padding: 16px 0 !important;
    }

    .email-container {
      margin: 0 16px !important;
      border-radius: 8px !important;
    }

    .header {
      padding: 32px 24px !important;
    }

    .logo {
      font-size: 32px !important;
    }

    .title {
      font-size: 24px !important;
    }

    .content {
      padding: 32px 24px !important;
    }

    .content h1 {
      font-size: 24px !important;
    }

    .button {
      display: block !important;
      width: 100% !important;
      text-align: center !important;
      padding: 18px 24px !important;
    }

    .footer {
      padding: 32px 24px !important;
    }

    .footer h4 {
      font-size: 18px !important;
    }
  }
</style>

<!-- Hero Section -->
<div style="text-align: center; padding: 30px 20px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; margin-bottom: 30px;">
  <div style="font-size: 48px; margin: 0 0 20px 0; display: block;">💳</div>
  <h1 style="font-size: 28px; font-weight: 700; color: #2c3e50; margin: 0 0 15px 0; line-height: 1.2;">Pagamento Aprovado!</h1>
  <p style="font-size: 16px; color: #666666; margin: 0; font-style: italic;">Seu pagamento foi processado com sucesso.</p>
</div>

<!-- Success Message -->
<div style="background: linear-gradient(135deg, #DCFCE7 0%, #F0FDF4 100%); border: 1px solid #BBF7D0; border-radius: 12px; padding: 24px; margin: 24px 0; text-align: center;">
  <div style="font-size: 48px; margin-bottom: 16px;">✅</div>
  <h3 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #166534;">Pagamento Confirmado</h3>
  <p style="margin: 0; font-size: 16px; color: #166534; line-height: 1.6;">Seu pagamento foi aprovado e seu pedido está sendo preparado para envio.</p>
</div>

<!-- Status Bar -->
{{> statusBar currentStatus=2 statusLabels=(array "Pedido Confirmado" "Pagamento Aprovado" "A Caminho" "Entregue")}}

<!-- Order Details -->
<div style="background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%); border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px; margin: 24px 0;">
  <h3 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #1E293B;">Resumo do Pedido</h3>
  <p style="margin: 10px 0; font-size: 15px; color: #64748B; line-height: 1.6;"><strong style="color: #1E293B; font-weight: 600;">Número do Pedido:</strong> #{{pedidoId}}</p>
  <p style="margin: 10px 0; font-size: 15px; color: #64748B; line-height: 1.6;"><strong style="color: #1E293B; font-weight: 600;">Data do Pagamento:</strong> {{dataPagamento}}</p>
  <p style="margin: 10px 0; font-size: 15px; color: #64748B; line-height: 1.6;"><strong style="color: #1E293B; font-weight: 600;">Método de Pagamento:</strong> {{metodoPagamento}}</p>
  <p style="margin: 10px 0; font-size: 15px; color: #64748B; line-height: 1.6;"><strong style="color: #1E293B; font-weight: 600;">Valor Pago:</strong> <span style="font-weight: 700; color: #10B981;">R$ {{total}}</span></p>
</div>

<!-- Products Section -->
<div style="margin: 30px 0;">
  <h2 style="font-size: 20px; font-weight: 700; color: #2c3e50; margin: 0 0 20px 0; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 3px solid #1E90FF; padding-bottom: 10px;">Produtos Aprovados</h2>

  {{#each produtos}}
    {{> productItem produto=.}}
  {{/each}}
</div>

<!-- Next Steps -->
<div style="background: linear-gradient(135deg, #FFF7ED 0%, #FFFBF7 100%); border: 1px solid #FED7AA; border-radius: 12px; padding: 24px; margin: 24px 0;">
  <h3 style="margin: 0 0 16px 0; font-size: 18px; font-weight: 600; color: #9A3412;">Próximos Passos</h3>
  <ul style="margin: 0; padding-left: 20px;">
    <li style="margin: 8px 0; font-size: 15px; color: #64748B; line-height: 1.6;">Seu pedido será preparado para envio</li>
    <li style="margin: 8px 0; font-size: 15px; color: #64748B; line-height: 1.6;">Você receberá uma atualização quando o pedido sair para entrega</li>
    <li style="margin: 8px 0; font-size: 15px; color: #64748B; line-height: 1.6;">Acompanhe o status do seu pedido em tempo real</li>
  </ul>
</div>

<!-- Message -->
<p style="margin: 30px 0 20px 0; font-size: 16px; line-height: 1.6; color: #555555;">
  Olá <strong style="color: #1E293B; font-weight: 600;">{{clienteNome}}</strong>! Seu pagamento foi aprovado com sucesso. Agora estamos preparando seu pedido para envio.
</p>

<p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #666666;">
  Você receberá notificações sobre cada etapa do processo de entrega. Qualquer dúvida, estamos à disposição.
</p>

<div style="text-align: center; margin: 40px 0;">
  <a href="{{frontendUrl}}/pedidos/{{pedidoId}}" style="display: inline-block; background: linear-gradient(135deg, #4F46E5 0%, #3B82F6 100%); color: #FFFFFF; padding: 16px 32px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; margin: 24px 0; box-shadow: 0 4px 14px 0 rgba(79, 70, 229, 0.25); min-height: 44px; line-height: 1.2;">VER MEU PEDIDO</a>
</div>

<p style="margin: 20px 0 0 0; font-size: 16px; font-weight: 600; color: #2c3e50;">
  Atenciosamente,<br>
  <span style="color: #1E90FF;">Equipe HelpNet</span>
</p>